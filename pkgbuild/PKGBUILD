pkgname=bigicons-papient
pkgdesc="Package icons for biglinux based in Papirus"
pkgver=$(date +%y.%m.%d)
pkgrel=$(date +%H%M)
arch=('any')
license=('GPL3')
url="https://github.com/biglinux/$pkgname"
provides=("$pkgname")
makedepends=('git' 'python')
source=("git+${url}.git")
md5sums=('SKIP')
if [ -e "${pkgname}.install" ];then
    install=${pkgname}.install
elif [ -e "pkgbuild.install" ];then
    install=pkgbuild.install
fi

package() {
    # Verify default folder
    if [ -d "${srcdir}/${pkgname}/${pkgname}" ]; then
        InternalDir="${srcdir}/${pkgname}/${pkgname}"
    else
        InternalDir="${srcdir}/${pkgname}"
    fi

    # Copy files
    if [ -d "${InternalDir}/usr" ]; then
        cp -r "${InternalDir}/usr" "${pkgdir}/"
    fi

    if [ -d "${InternalDir}/etc" ]; then
        cp -r "${InternalDir}/etc" "${pkgdir}/"
    fi

    if [ -d "${InternalDir}/opt" ]; then
        cp -r "${InternalDir}/opt" "${pkgdir}/"
    fi
    
    ############# Papirus Icons ##################
    cd "${pkgdir}/usr/share/icons/"
    git clone https://github.com/PapirusDevelopmentTeam/papirus-icon-theme.git
    
    # Copy icons
    cp -Rf papirus-icon-theme/Papirus/16x16 bigicons-papient/
    cp -Rf papirus-icon-theme/Papirus/22x22 bigicons-papient/
    cp -Rf papirus-icon-theme/Papirus/48x48 bigicons-papient/

    cp -Rf papirus-icon-theme/Papirus-Dark/16x16 bigicons-papient-dark/
    cp -Rf papirus-icon-theme/Papirus-Dark/22x22 bigicons-papient-dark/
 
    cp -Rf papirus-icon-theme/Papirus-Light/16x16 bigicons-papient-light/
#    cp -Rf papirus-icon-theme/Papirus-Light/22x22 bigicons-papient-light/
#
    
    # Not symbolic links share with not DARK theme
    cd bigicons-papient-dark
    cd 16x16
    rm apps categories emblems emotes mimetypes panel status
    ln -s ../../bigicons-papient/16x16/apps apps 
    ln -s ../../bigicons-papient/16x16/categories categories
    ln -s ../../bigicons-papient/16x16/emblems emblems
    ln -s ../../bigicons-papient/16x16/emotes emotes
    ln -s ../../bigicons-papient/16x16/mimetypes mimetypes
    ln -s ../../bigicons-papient/16x16/panel panel
    ln -s ../../bigicons-papient/16x16/status status
    cd ../22x22
    rm animations devices places apps categories emblems emotes mimetypes panel status
    ln -s ../../bigicons-papient/22x22/apps apps
    ln -s ../../bigicons-papient/22x22/categories categories
    ln -s ../../bigicons-papient/22x22/emblems emblems
    ln -s ../../bigicons-papient/22x22/emotes emotes
    ln -s ../../bigicons-papient/22x22/mimetypes mimetypes
    ln -s ../../bigicons-papient/22x22/panel panel
    ln -s ../../bigicons-papient/22x22/status status
    ln -s ../../bigicons-papient/22x22/animations animations
    ln -s ../../bigicons-papient/22x22/devices devices
    ln -s ../../bigicons-papient/22x22/places places
    cd ..
    ln -s ../bigicons-papient/48x48 48x48
    cd ..

    
    # Not symbolic links share with not LIGHT theme
    cd bigicons-papient-light
    cd 16x16
    rm -Rf apps categories emblems emotes mimetypes panel status actions devices places symbolic 
    ln -s ../../bigicons-papient/16x16/apps apps 
    ln -s ../../bigicons-papient/16x16/categories categories
    ln -s ../../bigicons-papient/16x16/emblems emblems
    ln -s ../../bigicons-papient/16x16/emotes emotes
    ln -s ../../bigicons-papient/16x16/mimetypes mimetypes
    ln -s ../../bigicons-papient/16x16/panel panel
    ln -s ../../bigicons-papient/16x16/actions actions
    ln -s ../../bigicons-papient/16x16/status status
    ln -s ../../bigicons-papient/16x16/devices devices
    ln -s ../../bigicons-papient/16x16/places places
    ln -s ../../bigicons-papient/16x16/symbolic symbolic

    mkdir ../22x22
    cd ../22x22
    rm -Rf animations devices places apps categories emblems emotes mimetypes panel status
    ln -s ../../bigicons-papient/22x22/actions actions
    ln -s ../../bigicons-papient/22x22/apps apps
    ln -s ../../bigicons-papient/22x22/categories categories
    ln -s ../../bigicons-papient/22x22/emblems emblems
    ln -s ../../bigicons-papient/22x22/emotes emotes
    ln -s ../../bigicons-papient/22x22/mimetypes mimetypes
    ln -s ../../bigicons-papient/22x22/panel panel
    ln -s ../../bigicons-papient/22x22/status status
    ln -s ../../bigicons-papient/22x22/animations animations
    ln -s ../../bigicons-papient/22x22/devices devices
    ln -s ../../bigicons-papient/22x22/places places
    ln -s ../../bigicons-papient/22x22/symbolic symbolic
    cd ..
    ln -s ../bigicons-papient/48x48 48x48
    cd ..
    # Change to hardcode light icons
    rm -Rf bigicons-papient-light/16x16/panel bigicons-papient-light/22x22/panel bigicons-papient-light/22x22/animations
    cp -Rf papirus-icon-theme/Papirus-Light/16x16/panel bigicons-papient-light/16x16/panel
    cp -Rf papirus-icon-theme/Papirus-Light/22x22/panel bigicons-papient-light/22x22/panel
    cp -Rf papirus-icon-theme/Papirus-Light/22x22/animations bigicons-papient-light/22x22/animations

    
    # Use on scaled screen
    cd bigicons-papient
    ln -s 16x16 16x16@2x
    ln -s 22x22 22x22@2x
    ln -s 48x48 48x48@2x
    cd ../
    
    # DARK
    cd bigicons-papient-dark
    ln -s 16x16 16x16@2x
    cd 16x16
    rm symbolic
    # The symbolic icons are drawn with fill:currentColor, so the light set
    # serves both themes and there is no second copy to keep. It is copied
    # rather than linked because not everything that reads an icon theme
    # follows symbolic links: QAdwaitaDecorations, which draws the title bar
    # of Qt applications on Wayland, walks the theme directory itself and
    # skips links, so it found no window-close-symbolic here and fell back to
    # its next theme - Breeze under a KDE platform theme. That is why the
    # Calamares title bar came up with Breeze chevrons on the dark theme
    # while every other Qt window kept the Adwaita buttons.
    cp -Rf ../../bigicons-papient/16x16/symbolic symbolic
    cd ..
    ln -s 22x22 22x22@2x
    cd 22x22
    rm symbolic
    cp -Rf ../../bigicons-papient/22x22/symbolic symbolic
    cd ..
    ln -s 48x48 48x48@2x
    cd ../

    
    # LIGHT
    cd bigicons-papient-light
    ln -s 16x16 16x16@2x
    ln -s 22x22 22x22@2x
    ln -s 48x48 48x48@2x
    cd ../
    
#     cp -f papirus-icon-theme/Papirus/16x16/apps/com.github.bajoja.indicator-kdeconnect.svg bigicons-papient/16x16/symbolic/apps/
#     cp -f papirus-icon-theme/Papirus/16x16/apps/kdeconnect.svg bigicons-papient/16x16/symbolic/apps/kdeconnect.svg

# #     # Kalarm symbolic dark PAPIENT
#     cd bigicons-papient-dark/16x16/panel; ln -s alarm-clock-panel.svg kalarm-symbolic.svg
#     cd ../../../
# # 
# #     # Kalarm symbolic PAPIENT
#     cd bigicons-papient/16x16/panel; ln -s alarm-clock-panel.svg kalarm-symbolic.svg
#     cd ../../../
# # 
# #     # manjaro-settings-manager.svg symbolic dark PAPIENT
#     cd bigicons-papient-dark/16x16/panel; ln -s manjaro-settings-manager-panel.svg manjaro-settings-manager.svg
#     cd ../../../
# # 
# #     # manjaro-settings-manager.svg symbolic PAPIENT
#     cd bigicons-papient/16x16/panel; ln -s manjaro-settings-manager-panel.svg manjaro-settings-manager.svg
#     cd ../../../

    # Fix menu icon used on dolphin and others
    cd bigicons-papient/16x16/actions
    ln -sf view-media-playlist.svg open-menu.svg
    ln -sf view-media-playlist.svg open-menu-symbolic.svg
    cd ../../../

    # DARK
    cd bigicons-papient-dark/16x16/actions
    ln -sf view-media-playlist.svg open-menu.svg
    ln -sf view-media-playlist.svg open-menu-symbolic.svg
    cd ../../../
    
    # LIGHT
    #cd bigicons-papient-light/16x16/actions
    #ln -sf view-media-playlist.svg open-menu.svg
    #ln -sf view-media-playlist.svg open-menu-symbolic.svg
    #cd ../../../

    # GTK 4 draws a "-symbolic" icon with its own SVG renderer, which ignores a
    # transform written on a group: Papirus icons drawn that way came out empty
    # or shifted (network-transmit-receive, night-light, software-update-available).
    # The script moves each group's transform onto the shapes inside it, which
    # draws the same picture everywhere else too.
    python "${InternalDir}/pkgbuild/flatten-group-transforms.py" \
        bigicons-papient bigicons-papient-dark bigicons-papient-light

    rm -R papirus-icon-theme
}
